# --- Credenciales y entornos -------------------------------------------------
# Nunca versionar .env reales; sí se versionan los ejemplos y la URL pública de producción.
.env
.env.*
!**/.env.example
!frontend/.env.production

# --- Python ------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Modelos de IA (se descargan por separado) --------------------------------
*.pt

# --- Node / frontend ----------------------------------------------------------
frontend/node_modules/
frontend/dist/
*.log

# --- Flutter / Dart -----------------------------------------------------------
movil/build/
movil/.dart_tool/
movil/.flutter-plugins
movil/.flutter-plugins-dependencies
movil/.pub-cache/
movil/.pub/
movil/coverage/
movil/.idea/
movil/android/.gradle/
movil/android/local.properties
movil/android/key.properties
movil/ios/Flutter/.last_build_id
movil/ios/Flutter/Generated.xcconfig

# --- Archivos de sistema ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
